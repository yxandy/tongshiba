<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ForumCommentLogMapper">

    <resultMap type="com.ruoyi.system.domain.ForumCommentLog" id="ForumCommentLogResult">
        <result property="logId" column="log_id" />
        <result property="postId" column="post_id" />
        <result property="commentId" column="comment_id" />
        <result property="floorNum" column="floor_num" />
        <result property="contentSummary" column="content_summary" />
        <result property="operatorName" column="operator_name" />
        <result property="operateTime" column="operate_time" />
    </resultMap>

    <select id="selectLogListByPostId" parameterType="Long" resultMap="ForumCommentLogResult">
        select log_id, post_id, comment_id, floor_num, content_summary, operator_name, operate_time
        from forum_comment_log
        where post_id = #{postId}
        order by operate_time desc
    </select>

    <insert id="insertForumCommentLog" parameterType="com.ruoyi.system.domain.ForumCommentLog" useGeneratedKeys="true" keyProperty="logId">
        insert into forum_comment_log (post_id, comment_id, floor_num, content_summary, operator_name, operate_time)
        values (#{postId}, #{commentId}, #{floorNum}, #{contentSummary}, #{operatorName}, sysdate())
    </insert>

</mapper>
