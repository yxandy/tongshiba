<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ForumCommentMapper">

    <resultMap type="com.ruoyi.system.domain.ForumComment" id="ForumCommentResult">
        <result property="commentId" column="comment_id" />
        <result property="postId" column="post_id" />
        <result property="userId" column="user_id" />
        <result property="userUnit" column="user_unit" />
        <result property="userDept" column="user_dept" />
        <result property="content" column="content" />
        <result property="floorNum" column="floor_num" />
        <result property="delFlag" column="del_flag" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <resultMap type="com.ruoyi.system.domain.ForumComment" id="ForumCommentWithUserResult" extends="ForumCommentResult">
        <association property="user" javaType="com.ruoyi.system.domain.ForumUser">
            <result property="userId" column="u_user_id" />
            <result property="wxUserid" column="u_wx_userid" />
            <result property="nickname" column="u_nickname" />
            <result property="avatar" column="u_avatar" />
            <result property="department" column="u_department" />
        </association>
    </resultMap>

    <sql id="selectForumCommentVo">
        select comment_id, post_id, user_id, user_unit, user_dept, content, floor_num, del_flag, create_time
        from forum_comment
    </sql>

    <sql id="selectForumCommentWithUser">
        select c.comment_id, c.post_id, c.user_id, c.user_unit, c.user_dept, c.content, c.floor_num, c.del_flag, c.create_time,
               u.user_id as u_user_id, u.wx_userid as u_wx_userid, u.nickname as u_nickname, u.avatar as u_avatar, u.department as u_department
        from forum_comment c
        left join forum_user u on c.user_id = u.user_id
    </sql>

    <select id="selectForumCommentById" parameterType="Long" resultMap="ForumCommentWithUserResult">
        <include refid="selectForumCommentWithUser"/>
        where c.comment_id = #{commentId}
    </select>

    <select id="selectForumCommentList" parameterType="com.ruoyi.system.domain.ForumComment" resultMap="ForumCommentWithUserResult">
        <include refid="selectForumCommentWithUser"/>
        <where>
            <!-- 支持按删除状态筛选：默认只查未删除，传 '1' 查已删除，传 '2' 查全部 -->
            <choose>
                <when test="delFlag != null and delFlag.toString() == '1'.toString()">
                    c.del_flag = '1'
                </when>
                <when test="delFlag != null and delFlag.toString() == '2'.toString()">
                    1=1
                </when>
                <otherwise>
                    c.del_flag = '0'
                </otherwise>
            </choose>
            <if test="postId != null">
                AND c.post_id = #{postId}
            </if>
            <if test="userId != null">
                AND c.user_id = #{userId}
            </if>
        </where>
        order by c.floor_num asc
    </select>

    <select id="selectForumCommentByPostId" parameterType="Long" resultMap="ForumCommentWithUserResult">
        <include refid="selectForumCommentWithUser"/>
        where c.post_id = #{postId} and c.del_flag = '0'
        order by c.floor_num asc
    </select>

    <select id="selectMaxFloorNumByPostId" parameterType="Long" resultType="Integer">
        select IFNULL(max(floor_num), 0) from forum_comment where post_id = #{postId} and del_flag = '0'
    </select>

    <insert id="insertForumComment" parameterType="com.ruoyi.system.domain.ForumComment" useGeneratedKeys="true" keyProperty="commentId">
        insert into forum_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="postId != null">post_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userUnit != null">user_unit,</if>
            <if test="userDept != null">user_dept,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="floorNum != null">floor_num,</if>
            del_flag,
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="postId != null">#{postId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userUnit != null">#{userUnit},</if>
            <if test="userDept != null">#{userDept},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="floorNum != null">#{floorNum},</if>
            '0',
            sysdate()
        </trim>
    </insert>

    <update id="updateForumComment" parameterType="com.ruoyi.system.domain.ForumComment">
        update forum_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null">content = #{content},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where comment_id = #{commentId}
    </update>

    <update id="deleteForumCommentById" parameterType="Long">
        update forum_comment set del_flag = '1' where comment_id = #{commentId}
    </update>

    <update id="deleteForumCommentByIds" parameterType="String">
        update forum_comment set del_flag = '1' where comment_id in
        <foreach item="commentId" collection="array" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </update>

    <update id="deleteForumCommentByPostId" parameterType="Long">
        update forum_comment set del_flag = '1' where post_id = #{postId}
    </update>

    <update id="logicalDeleteById">
        update forum_comment set del_flag = '1', deleted_by = #{deletedBy} where comment_id = #{commentId}
    </update>

    <update id="restoreComment" parameterType="Long">
        update forum_comment set del_flag = '0', deleted_by = null where comment_id = #{commentId}
    </update>

</mapper>
