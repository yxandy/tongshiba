<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ForumPostLogMapper">

    <resultMap type="com.ruoyi.system.domain.ForumPostLog" id="ForumPostLogResult">
        <result property="logId" column="log_id" />
        <result property="postId" column="post_id" />
        <result property="action" column="action" />
        <result property="operatorId" column="operator_id" />
        <result property="operatorName" column="operator_name" />
        <result property="description" column="description" />
        <result property="operateTime" column="operate_time" />
    </resultMap>

    <select id="selectLogListByPostId" parameterType="Long" resultMap="ForumPostLogResult">
        select log_id, post_id, action, operator_id, operator_name, description, operate_time
        from forum_post_log
        where post_id = #{postId}
        order by operate_time desc
    </select>

    <insert id="insertForumPostLog" parameterType="com.ruoyi.system.domain.ForumPostLog" useGeneratedKeys="true" keyProperty="logId">
        insert into forum_post_log (post_id, action, operator_id, operator_name, description, operate_time)
        values (#{postId}, #{action}, #{operatorId}, #{operatorName}, #{description}, sysdate())
    </insert>

</mapper>
