<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ForumPostMapper">

    <resultMap type="com.ruoyi.system.domain.ForumPost" id="ForumPostResult">
        <result property="postId" column="post_id" />
        <result property="userId" column="user_id" />
        <result property="userUnit" column="user_unit" />
        <result property="userDept" column="user_dept" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="images" column="images" />
        <result property="viewCount" column="view_count" />
        <result property="commentCount" column="comment_count" />
        <result property="isLocked" column="is_locked" />
        <result property="delFlag" column="del_flag" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="lastReplyTime" column="last_reply_time" />
    </resultMap>

    <resultMap type="com.ruoyi.system.domain.ForumPost" id="ForumPostWithUserResult" extends="ForumPostResult">
        <association property="user" javaType="com.ruoyi.system.domain.ForumUser">
            <result property="userId" column="u_user_id" />
            <result property="wxUserid" column="u_wx_userid" />
            <result property="nickname" column="u_nickname" />
            <result property="avatar" column="u_avatar" />
            <result property="department" column="u_department" />
        </association>
    </resultMap>

    <sql id="selectForumPostVo">
        select post_id, user_id, user_unit, user_dept, title, content, images, view_count, comment_count, is_locked, del_flag, create_time, update_time
        from forum_post
    </sql>

    <sql id="selectForumPostWithUser">
        select p.post_id, p.user_id, p.user_unit, p.user_dept, p.title, p.content, p.images, p.view_count, p.comment_count, p.is_locked, p.del_flag, p.create_time, p.update_time, p.last_reply_time,
               u.user_id as u_user_id, u.wx_userid as u_wx_userid, u.nickname as u_nickname, u.avatar as u_avatar, u.department as u_department
        from forum_post p
        left join forum_user u on p.user_id = u.user_id
    </sql>

    <select id="selectForumPostById" parameterType="Long" resultMap="ForumPostWithUserResult">
        <include refid="selectForumPostWithUser"/>
        where p.post_id = #{postId}
    </select>

    <select id="selectForumPostList" parameterType="com.ruoyi.system.domain.ForumPost" resultMap="ForumPostWithUserResult">
        <include refid="selectForumPostWithUser"/>
        <where>
            <!-- 支持按删除状态筛选：默认只查未删除，传 '1' 查已删除，传 '2' 查全部 -->
            <choose>
                <when test="delFlag != null and delFlag.toString() == '1'.toString()">
                    p.del_flag = '1'
                </when>
                <when test="delFlag != null and delFlag.toString() == '2'.toString()">
                    1=1
                </when>
                <otherwise>
                    p.del_flag = '0'
                </otherwise>
            </choose>
            <if test="userId != null">
                AND p.user_id = #{userId}
            </if>
            <if test="title != null and title != ''">
                AND p.title like concat('%', #{title}, '%')
            </if>
            <if test="isLocked != null and isLocked != ''">
                AND p.is_locked = #{isLocked}
            </if>
            <if test="userUnit != null and userUnit != ''">
                AND p.user_unit like concat('%', #{userUnit}, '%')
            </if>
            <if test="userDept != null and userDept != ''">
                AND p.user_dept like concat('%', #{userDept}, '%')
            </if>
            <if test="user != null and user.nickname != null and user.nickname != ''">
                AND u.nickname like concat('%', #{user.nickname}, '%')
            </if>
        </where>
        order by COALESCE(p.last_reply_time, p.create_time) desc
    </select>

    <!-- 查询用户关注的帖子列表 -->
    <select id="selectFollowedPostList" resultMap="ForumPostWithUserResult">
        <include refid="selectForumPostWithUser"/>
        <where>
            p.del_flag = '0'
            AND p.post_id IN
            <foreach item="postId" collection="postIds" open="(" separator="," close=")">
                #{postId}
            </foreach>
        </where>
        order by COALESCE(p.last_reply_time, p.create_time) desc
    </select>

    <insert id="insertForumPost" parameterType="com.ruoyi.system.domain.ForumPost" useGeneratedKeys="true" keyProperty="postId">
        insert into forum_post
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userUnit != null">user_unit,</if>
            <if test="userDept != null">user_dept,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null">content,</if>
            <if test="images != null">images,</if>
            view_count,
            comment_count,
            is_locked,
            del_flag,
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userUnit != null">#{userUnit},</if>
            <if test="userDept != null">#{userDept},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="images != null">#{images},</if>
            0,
            0,
            '0',
            '0',
            sysdate()
        </trim>
    </insert>

    <update id="updateForumPost" parameterType="com.ruoyi.system.domain.ForumPost">
        update forum_post
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="images != null">images = #{images},</if>
            <if test="isLocked != null">is_locked = #{isLocked},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            update_time = sysdate()
        </trim>
        where post_id = #{postId}
    </update>

    <update id="deleteForumPostById" parameterType="Long">
        update forum_post set del_flag = '1', update_time = sysdate() where post_id = #{postId}
    </update>

    <update id="deleteForumPostByIds" parameterType="String">
        update forum_post set del_flag = '1', update_time = sysdate() where post_id in
        <foreach item="postId" collection="array" open="(" separator="," close=")">
            #{postId}
        </foreach>
    </update>

    <update id="incrementViewCount" parameterType="Long">
        update forum_post set view_count = view_count + 1 where post_id = #{postId}
    </update>

    <update id="incrementCommentCount" parameterType="Long">
        update forum_post set comment_count = comment_count + 1 where post_id = #{postId}
    </update>

    <update id="decrementCommentCount" parameterType="Long">
        update forum_post set comment_count = comment_count - 1 where post_id = #{postId} and comment_count > 0
    </update>

    <update id="updateLastReplyTime">
        update forum_post set last_reply_time = #{lastReplyTime} where post_id = #{postId}
    </update>

</mapper>
